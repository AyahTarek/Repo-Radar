# Optional. Without a token the GitHub API allows 60 requests/hour per IP
# (and 10 searches/minute); with one it allows 5,000 requests/hour.
#
# Anything prefixed with VITE_ is inlined into the client bundle and is therefore
# public. Use a fine-grained personal access token with NO scopes and no
# repository access, or leave this empty.
VITE_GITHUB_TOKEN=
