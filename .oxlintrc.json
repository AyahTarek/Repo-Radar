{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-imports": "error",
    "import/no-default-export": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "smart"],
    "import/no-unassigned-import": [
      "warn",
      { "allow": ["**/*.css", "@testing-library/jest-dom/vitest"] }
    ]
  },
  "overrides": [
    {
      "files": ["**/vite.config.ts", "**/vitest.config.ts", "**/.storybook/*.ts", "**/.storybook/*.tsx", "**/*.stories.tsx"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      // A route table is configuration, not a fast-refresh boundary.
      "files": ["**/app/router/index.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.setup.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "coverage"]
}
