{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd apps/web && pnpm build",
  "outputDirectory": "apps/web/dist",
  "routes": [
    { "src": "^/assets/(.*)$", "dest": "/assets/$1" },
    { "src": "^/favicon\\.svg$", "dest": "/favicon.svg" },
    { "src": ".*", "dest": "/index.html" }
  ]
}
