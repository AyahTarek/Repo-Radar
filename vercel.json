{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "nodeVersion": "22.x",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
